{
  "name": "backend",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild boot.ts --platform=node --bundle --format=esm --outdir=dist",
    "start": "NODE_ENV=production node dist/boot.js",
    "check": "tsc -b",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1042.0",
    "@aws-sdk/s3-request-presigner": "^3.1042.0",
    "@hono/node-server": "^2.0.1",
    "@trpc/server": "^11.17.0",
    "cookie": "^1.1.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.16",
    "jose": "^6.2.3",
    "mysql2": "^3.22.3",
    "nanoid": "^5.1.11",
    "superjson": "^2.2.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
